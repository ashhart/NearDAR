{
  "expo": {
    "name": "NearDAR",
    "slug": "sonar",
    "scheme": "sonar",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.tensorfold.sonar",
      "infoPlist": {
        "NSCameraUsageDescription": "Identify nearby objects, obstacles, seats, and text. Images are processed on this device.",
        "NSMicrophoneUsageDescription": "Hear your questions through the phone microphone or a connected headset. Audio stays on this device.",
        "NSSpeechRecognitionUsageDescription": "Convert your spoken questions into text on this device.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.tensorfold.sonar",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Let NearDAR read your approximate location when you ask where you are.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "17.0" },
          "android": {
            "minSdkVersion": 29,
            "kotlinVersion": "2.3.0",
            "buildArchs": ["arm64-v8a", "x86_64"]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EC",
          "dark": { "backgroundColor": "#171622" }
        }
      ],
      "./plugins/with-guide-config.cjs"
    ]
  }
}
