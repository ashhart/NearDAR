{
  "name": "sonar",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "bun run vendor:litert-ios && expo run:ios --device",
    "vendor:litert-ios": "bash scripts/vendor-litert-ios.sh",
    "android": "expo run:android --device",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "bun test tests/*.test.ts",
    "verify": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.31",
    "expo-build-properties": "~55.0.1",
    "expo-haptics": "~55.0.18",
    "expo-keep-awake": "~55.0.8",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.20",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "19.2.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~55.0.1",
    "typescript": "~5.9.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
